<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <style name="Theme.EkoFlash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/neon_purple</item>
        <item name="colorTertiary">@color/neon_green</item>
        
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        
        <item name="android:fontFamily">sans-serif-medium</item>

        <item name="linearProgressIndicatorStyle">@style/Widget.Eko.LinearProgress</item>
        
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>

        <item name="alertDialogTheme">@style/ShadowAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ShadowAlertDialog</item>
    </style>

    <style name="Widget.Eko.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/white_alpha_5</item>
        <item name="indicatorColor">@color/neon_cyan</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackThickness">8dp</item>
    </style>

    <style name="ShadowAlertDialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Eko.Rounded</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="ShapeAppearance.Eko.Rounded" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="FlashButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-black</item> <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1.2dp</item>
        <item name="cornerRadius">18dp</item>
        
        <item name="backgroundTint">@color/bg_card</item>
        <item name="rippleColor">@color/glow_cyan_med</item>
        
        <item name="iconTint">@color/neon_cyan</item>
        <item name="iconSize">22dp</item>
        <item name="android:paddingStart">20dp</item>
    </style>

    <style name="MainStartButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-condensed-light</item> <item name="android:letterSpacing">0.25</item>
        <item name="cornerRadius">20dp</item>
        
        <item name="backgroundTint">@color/neon_purple</item>
        <item name="android:textColor">#000000</item>
        <item name="android:elevation">10dp</item>
        <item name="rippleColor">#AAFFFFFF</item>
        
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="OptionRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">22dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/option_card_glow</item> </style>

    <style name="Theme.EkoFlash.Splash" parent="Theme.EkoFlash">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#080A0F</item>
        <item name="android:navigationBarColor">#080A0F</item>
    </style>


    <style name="ConsoleTextStyle">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/neon_green</item>
        <item name="android:lineSpacingExtra">6dp</item>
        
        <item name="android:shadowColor">@color/glow_green_low</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">12.0</item>
    </style>

</resources>
