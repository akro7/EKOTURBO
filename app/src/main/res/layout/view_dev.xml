<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:clipToPadding="false"
    android:background="#050507">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CORE DEVELOPERS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect with the engineering team"
            android:textColor="#6272A4"
            android:textSize="12sp"
            android:layout_marginBottom="30dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dev_cat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#12121A"
            app:cardCornerRadius="24dp"
            app:strokeColor="#4000E5FF"
            app:strokeWidth="1.2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <RelativeLayout
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/img_cat_emoji"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="👨‍💻"
                    android:textSize="32sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txt_name_omar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_cat_emoji"
                    android:layout_marginStart="16dp"
                    android:text="OMaR 💠"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_cat_emoji"
                    android:layout_below="@id/txt_name_omar"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="2dp"
                    android:text="Lead Software Engineer"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="#406272A4" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_dev_kojo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121A"
            app:cardCornerRadius="24dp"
            app:strokeColor="#40BD93F9"
            app:strokeWidth="1.2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <RelativeLayout
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/img_kojo_emoji"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:text="👨‍💻"
                    android:textSize="32sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txt_name_ahmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_kojo_emoji"
                    android:layout_marginStart="16dp"
                    android:text="Ahmed 💠"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_kojo_emoji"
                    android:layout_below="@id/txt_name_ahmed"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="2dp"
                    android:text="Senior Logic Designer"
                    android:textColor="#BD93F9"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="#406272A4" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
