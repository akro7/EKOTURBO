<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020204"
    android:layoutDirection="ltr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarSize="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══ HEADER — EKO TURBO + speed ════════════════════════════ -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="52dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true">

                    <!-- EKO (cyan) + TURBO (purple) in one line -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <TextView
                            android:id="@+id/tv_eko_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="EKO "
                            android:textColor="#00E5FF"
                            android:textSize="32sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:text="TURBO"
                            android:textColor="#BD93F9"
                            android:textSize="32sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-4dp"
                        android:letterSpacing="0.25"
                        android:text="LOKE STREAMING • ENGINE V5.0"
                        android:textColor="#00E5FF"
                        android:textSize="8.5sp"
                        android:fontFamily="sans-serif-black" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_transfer_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/speed_tag_bg"
                    android:text="0.0 MB/s"
                    android:textColor="#BD93F9"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- ═══ STATUS CARD ══════════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="15dp"
                app:cardBackgroundColor="#0D0D14"
                app:cardCornerRadius="32dp"
                app:cardElevation="25dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1.2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="22dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/stat_sys_data_bluetooth"
                        app:tint="#00E5FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:text="DATA LINK STATUS"
                        android:textColor="#6272A4"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-black" />

                    <TextView
                        android:id="@+id/tv_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="BAT: --%"
                        android:textColor="#6272A4"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/device_info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="38dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_device_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="IDLE"
                            android:textColor="#00E5FF"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PUSHING BINARY DATA VIA ODIN PROTOCOL"
                            android:textColor="#30FFFFFF"
                            android:textSize="9sp"
                            android:letterSpacing="0.05"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/device_info_container"
                        android:layout_marginTop="35dp"
                        android:layout_toStartOf="@+id/progress_percent"
                        android:layout_marginEnd="18dp"
                        app:indicatorColor="#00E5FF"
                        app:trackColor="#12FFFFFF"
                        app:trackThickness="16dp"
                        app:trackCornerRadius="10dp"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/device_info_container"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-black"
                        android:text="0%"
                        android:textColor="#FFFFFF"
                        android:textSize="42sp" />

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ CHANNELS SECTION ══════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Section label -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="10dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="#00E5FF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="DATA STREAM CHANNELS"
                        android:textColor="#6272A4"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.2"
                        android:textAllCaps="true" />
                </LinearLayout>

                <!-- BL -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_bl"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginBottom="14dp"
                    android:tag="BL"
                    android:text="BL : BOOTLOADER STAGE"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#0A0A0F"
                    app:cornerRadius="20dp"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="1.2dp"
                    app:icon="@android:drawable/ic_lock_idle_lock"
                    app:iconSize="22dp"
                    app:iconPadding="18dp"
                    app:iconTint="#00E5FF"
                    app:rippleColor="#2200E5FF" />

                <!-- AP — highlighted -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3300E5FF"
                    app:strokeWidth="1.5dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ap"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="85dp"
                        android:tag="AP"
                        android:text="AP : SYSTEM ENGINE (RAW)"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:textAlignment="viewStart"
                        android:paddingStart="20dp"
                        app:backgroundTint="#12121A"
                        app:cornerRadius="20dp"
                        app:strokeWidth="0dp"
                        app:icon="@android:drawable/ic_menu_set_as"
                        app:iconSize="26dp"
                        app:iconPadding="18dp"
                        app:iconTint="#BD93F9"
                        app:rippleColor="#44BD93F9" />
                </com.google.android.material.card.MaterialCardView>

                <!-- CP -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginBottom="14dp"
                    android:tag="CP"
                    android:text="CP : RADIO / BASEBAND"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#0A0A0F"
                    app:cornerRadius="20dp"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="1.2dp"
                    app:icon="@android:drawable/stat_sys_phone_call"
                    app:iconSize="22dp"
                    app:iconPadding="18dp"
                    app:iconTint="#00E5FF"
                    app:rippleColor="#2200E5FF" />

                <!-- CSC -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_csc"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginBottom="14dp"
                    android:tag="CSC"
                    android:text="CSC : LOCALIZATION"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#0A0A0F"
                    app:cornerRadius="20dp"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="1.2dp"
                    app:icon="@android:drawable/ic_menu_mapmode"
                    app:iconSize="22dp"
                    app:iconPadding="18dp"
                    app:iconTint="#BD93F9"
                    app:rippleColor="#22BD93F9" />

                <!-- USERDATA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_userdata"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginBottom="20dp"
                    android:tag="USERDATA"
                    android:text="USERDATA : MASS STORAGE"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#0A0A0F"
                    app:cornerRadius="20dp"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="1.2dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconSize="22dp"
                    app:iconPadding="18dp"
                    app:iconTint="#00E5FF"
                    app:rippleColor="#2200E5FF" />

                <!-- START FLASH button -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="25dp"
                    app:cardBackgroundColor="#00E5FF"
                    app:strokeWidth="0dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_flash"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="START FLASH"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:textColor="#050507"
                            app:backgroundTint="#00E5FF"
                            app:cornerRadius="28dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:rippleColor="#88FFFFFF"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconSize="26dp"
                            app:iconTint="#050507"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Cancel button (hidden by default) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="CANCEL"
                    android:textColor="#FF4D4D"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:visibility="gone"
                    app:cornerRadius="20dp"
                    app:rippleColor="#22FF4D4D" />

                <View android:layout_width="match_parent" android:layout_height="120dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
