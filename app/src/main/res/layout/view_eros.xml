<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="#050507"
    android:padding="20dp"
    android:scrollbarSize="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="25dp">
            
            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="#00E5FF" /> 
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="DATA STREAM CHANNELS"
                android:textColor="#6272A4"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.2"
                android:textAllCaps="true" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bl"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginBottom="14dp"
            android:tag="BL"
            android:text="BL : BOOTLOADER STAGE"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:paddingStart="20dp"
            app:backgroundTint="#0A0A0F"
            app:cornerRadius="20dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1.2dp"
            app:icon="@android:drawable/ic_lock_idle_lock"
            app:iconSize="22dp"
            app:iconPadding="18dp"
            app:iconTint="#00E5FF"
            app:rippleColor="#2200E5FF" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#3300E5FF"
            app:strokeWidth="1.5dp">
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:tag="AP"
                android:text="AP : SYSTEM ENGINE (RAW)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-black"
                android:textAlignment="viewStart"
                android:paddingStart="20dp"
                app:backgroundTint="#12121A"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp"
                app:icon="@android:drawable/ic_menu_set_as"
                app:iconSize="26dp"
                app:iconPadding="18dp"
                app:iconTint="#BD93F9"
                app:rippleColor="#44BD93F9" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginBottom="14dp"
            android:tag="CP"
            android:text="CP : RADIO / BASEBAND"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:paddingStart="20dp"
            app:backgroundTint="#0A0A0F"
            app:cornerRadius="20dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1.2dp"
            app:icon="@android:drawable/stat_sys_phone_call"
            app:iconSize="22dp"
            app:iconPadding="18dp"
            app:iconTint="#00E5FF"
            app:rippleColor="#2200E5FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_csc"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginBottom="14dp"
            android:tag="CSC"
            android:text="CSC : LOCALIZATION"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:paddingStart="20dp"
            app:backgroundTint="#0A0A0F"
            app:cornerRadius="20dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1.2dp"
            app:icon="@android:drawable/ic_menu_mapmode"
            app:iconSize="22dp"
            app:iconPadding="18dp"
            app:iconTint="#BD93F9"
            app:rippleColor="#22BD93F9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_userdata"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginBottom="35dp"
            android:tag="USERDATA"
            android:text="USERDATA : MASS STORAGE"
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"
            android:paddingStart="20dp"
            app:backgroundTint="#0A0A0F"
            app:cornerRadius="20dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1.2dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconSize="22dp"
            app:iconPadding="18dp"
            app:iconTint="#00E5FF"
            app:rippleColor="#2200E5FF" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="90dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="25dp"
            app:cardBackgroundColor="#00E5FF"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_flash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="START DATA STREAM"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1"
                    android:textColor="#050507"
                    app:backgroundTint="#00E5FF"
                    app:cornerRadius="28dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:rippleColor="#88FFFFFF"
                    app:icon="@android:drawable/ic_media_play"
                    app:iconSize="26dp"
                    app:iconTint="#050507"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp" />

    </LinearLayout>
</ScrollView>
